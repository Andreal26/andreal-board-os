# ─────────────────────────────────────────────────────────────
# Andreal Board OS — settings
# Hugging Face: add each of these under Space → Settings → Variables and secrets.
#   • Put passwords / tokens / keys in "Secrets".  • Put plain settings in "Variables".
# Local: copy this file to .env.local
# ─────────────────────────────────────────────────────────────

# [SECRET, optional] Signs login sessions. If empty, a secret is generated once and stored in the database.
AUTH_SECRET=

# First admin account — created automatically on first start with an empty database.
ADMIN_EMAIL=admin@andreal.in
# [SECRET, required in production] First admin's password (used only while there are no users). Locally defaults to "change-me-now".
ADMIN_PASSWORD=
ADMIN_NAME=Board Admin

# [VARIABLE] Public URL of the Space (used in email links), e.g. https://andreal-board-os.hf.space
APP_URL=http://localhost:3000

# Database
# Default: built-in Postgres (PGlite). On Hugging Face the Dockerfile sets
#   PGLITE_DIR=/home/node/pgdata            (live database, fast local disk)
#   PGLITE_BACKUP=/data/board-os-db.tar.gz  (backup every minute after changes; restored on start)
#   → Mount a Storage Bucket at /data (read-write), otherwise data is wiped on every restart.
# PGLITE_BACKUP_SECONDS=60
# Optional [SECRET]: use an external Postgres (Supabase / Neon) instead:
DATABASE_URL=

# [VARIABLE] Load the 9 workbook R&D initiatives automatically on an empty database (default true)
SEED_WORKBOOK=true

# [VARIABLE] Built-in scheduler — India time, 24h. Set SCHEDULER_ENABLED=false to switch off.
SCHEDULER_ENABLED=true
SCHEDULE_SYNC=06:00
SCHEDULE_SNAPSHOT=06:30
SCHEDULE_ALERTS=08:30
SCHEDULE_WEEKLY=MON 09:00

# [SECRET] Optional: lets an external scheduler call /api/cron/<job> with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── Email (free: Gmail SMTP with an App Password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# [SECRET]
SMTP_PASS=
MAIL_FROM="Andreal Board OS <you@gmail.com>"
# Comma-separated CEO / board recipients for the daily digest and weekly pack
BOARD_EMAILS=

# ── Integrations (all OFF until <NAME>_ENABLED=true and the keys are filled; keys are SECRETS) ──
# Zoho: add ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET (Server-based client, redirect URI <APP_URL>/api/integrations/zoho/callback),
# then Settings → Connect Zoho. ZOHO_REFRESH_TOKEN is optional (overrides the stored connection).
# ZOHO_ENABLED=false switches it off.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_API_VERSION=v2
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho field API names that differ per org (defaults match the "Andreal Deals" export columns)
ZOHO_FIELD_STATUS=Deal_Status
ZOHO_FIELD_COMPANY=WORK_DONE_FOR
ZOHO_FIELD_PRODUCT=Product
ZOHO_FIELD_PROSPECTOR=Prospector
ZOHO_FIELD_LOST_REASON=Reason_For_Loss__s

META_ENABLED=false
META_API_VERSION=v21.0
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_COMPANY=Andreal

GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_API_VERSION=v18
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_IDS=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_COMPANY=Andreal

LINKEDIN_ENABLED=false
LINKEDIN_API_VERSION=202410
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_IDS=
LINKEDIN_COMPANY=Andreal
